# ── Local fallback database ─────────────────────────────────────────────────
# Only used when the FIREBASE_* vars below are absent.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Primary datasource: Firebase web-app config (public keys) ───────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# Paste the six values exactly as shown (see FIREBASE_SETUP.md).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Admin identity (Firestore mode) ─────────────────────────────────────────
# Same email as hardcoded in firestore.rules. Used by /admin (Google sign-in,
# for reference) and by the seed script (email/password sign-in).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Admin gate for /admin in Postgres fallback mode (optional) ─────────────
ADMIN_KEY=sizing-admin
