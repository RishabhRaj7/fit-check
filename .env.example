# ── Local fallback database ─────────────────────────────────────────────────
# Only used when the FIREBASE_* vars below are absent.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Primary datasource: Firebase / Firestore (Admin SDK) ────────────────────
# Copy these three from the service-account key JSON (see FIREBASE_SETUP.md):
#   project_id    -> FIREBASE_PROJECT_ID
#   client_email  -> FIREBASE_CLIENT_EMAIL
#   private_key   -> FIREBASE_PRIVATE_KEY  (keep the \n line breaks as-is;
#                                           the app normalises them)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Admin gate for /admin (optional) ────────────────────────────────────────
# Header: x-admin-key. Defaults to "sizing-admin" when unset.
ADMIN_KEY=sizing-admin
