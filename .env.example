# ── Firebase web-app config (public identifiers) ────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# The server reads the catalogue with these; the browser uses them for
# Google sign-in. Access control lives in firestore.rules.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
