rules_version = '2';

// ── Fit Check security rules ────────────────────────────────────────────────
// • brands / charts / products — public catalogue. Anyone can READ; only the
//   admin account can WRITE (Google sign-in on /admin, or the seed script).
// • users/{uid} — one private size profile per account. Only its owner can
//   read or write it, and only in the shape the app writes.
//
// Admins are identified by Firebase Auth UID (stable, unlike an email).
// Find UIDs under Authentication → Users, then: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin accounts, by Firebase Auth UID. Google sign-in (/admin) and the
    // seed script's email/password login are separate Firebase users with
    // different UIDs, so list both. The seed prints its UID when it runs.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "UBcMuGNyIMVLOJ0f9fHY2qrc75v1"  // admin Google account (/admin)
        ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // { sizeProfile: map (≤ 40 entries), updatedAt: number }
    function validValues(d) {
      return (!("sizeProfile" in d) || (d.sizeProfile is map && d.sizeProfile.size() <= 40))
        && (!("updatedAt" in d) || d.updatedAt is number);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["sizeProfile", "updatedAt"])
        && validValues(request.resource.data);
      // Writes may only add/change these two fields; removing anything is
      // allowed (the app clears fields left behind by older versions).
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).addedKeys()
             .union(request.resource.data.diff(resource.data).changedKeys())
             .hasOnly(["sizeProfile", "updatedAt"])
        && validValues(request.resource.data);
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /charts/{chartId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
